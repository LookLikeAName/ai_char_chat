{
  "name": "@acc/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=../../.env src/api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "node build.mjs",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
