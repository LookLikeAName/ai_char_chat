# 複製成 .env 後修改。

# 必填：加密 API key 用的密鑰（至少 16 字元）。產生方式：openssl rand -base64 32
# 注意：改掉之後，已經存的 API key 就解不開了，要重新輸入。
APP_SECRET=

# 資料庫密碼（第一次啟動時寫入；之後改這裡不會改到既有資料庫）
POSTGRES_PASSWORD=change-me

# 網頁的 port 與綁定位址（0.0.0.0 會開放給區網其他裝置）
WEB_PORT=8080
WEB_BIND=127.0.0.1

# 以下只有本機開發（npm run dev:*）時使用
DATABASE_URL=postgres://acc:change-me@localhost:5432/acc
REDIS_URL=redis://localhost:6379
MEDIA_DIR=./data/media
